// Cloudflare deployment config: one Worker that serves the built React app and the /api routes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortage-copilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],

  // The built React app (the Cloudflare Vite plugin supplies the folder).
  // /api/* runs the Worker first; any other path serves the app.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Saved drafts (7 days) and the daily AI-draft counter.
  "kv_namespaces": [{ "binding": "NOTES", "id": "d29727b84ab24b73a9442e7ec73c4904" }],

  // Per-visitor limit: 5 AI drafts per minute.
  "ratelimits": [{ "name": "DRAFT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],

  // Site-wide daily caps on fresh AI work (saved drafts and replayed agent runs don't count).
  "vars": { "DAILY_AI_CAP": "150", "AGENT_DAILY_CAP": "40" },

  "observability": { "enabled": true }
  // The API key is NOT here. It is stored encrypted with: npx wrangler secret put ANTHROPIC_API_KEY
}
